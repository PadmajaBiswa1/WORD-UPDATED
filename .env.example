# Server Port (fixed to 3000 in AI Studio)
PORT=3000

# Server-side Gemini API Key (optional, automatically provided in AI Studio)
GEMINI_API_KEY=

# MongoDB URI (optional, automatically falls back to local JSON store in backend/data/)
MONGO_URI=

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# Frontend URL (optional, defaults to reflection)
FRONTEND_URL=

# Ollama Configuration (fallback AI service)
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=

# EmailJS Service Credentials (optional for OTP verification)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# IPFS Pinata Service Credentials (optional)
IPFS_ENABLED=false
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
