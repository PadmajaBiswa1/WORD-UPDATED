# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Uploads
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Build output
frontend/dist/

# Vite cache
frontend/node_modules/.vite/
frontend/test-results/
frontend/playwright-report/

# Environment files
backend/.env
frontend/.env
.env

# Rootfs archives
*-rootfs.tar.gz

# Local database runtime files
backend/data/*.json
!backend/data/documents.json

# Only frontend/ and backend/ are published; everything else at the root stays local
/*
!/frontend/
!/backend/
!/.gitignore

# Markdown stays local
*.md
